#!/usr/bin/env python3
"""tools/prompt <func> [haiku|sonnet] — prints the matcher task prompt for one function."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import mkwave  # noqa: E402

if len(sys.argv) < 2:
    sys.exit(__doc__)
func, tier = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "haiku")
note = next((r["note"] for r in mkwave.ffclib.queue_rows() if r["func"] == func), "")
print(mkwave.build(func, tier, mkwave.v54_extra(note)))
